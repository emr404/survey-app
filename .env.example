# Copy this file to .env.local. Never put this key in a VUE_APP_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Demo is local, labelled simulation and makes no paid model calls.
# Switch to live only when you want to use your configured OpenAI API account.
AI_MODE=demo
# Preferred API port; if occupied, an available port is selected automatically.
API_PORT=3001
