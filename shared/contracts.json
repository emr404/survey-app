{
  "preferences": {
    "type": "object",
    "properties": {
      "departure": {
        "type": "string",
        "maxLength": 100
      },
      "currency": {
        "type": "string",
        "enum": [
          "GBP",
          "EUR",
          "USD"
        ]
      },
      "dailyBudget": {
        "type": "number",
        "minimum": 0,
        "maximum": 10000
      },
      "travellers": {
        "type": "integer",
        "minimum": 1
      },
      "days": {
        "type": "integer",
        "minimum": 1
      },
      "timing": {
        "type": "string",
        "enum": [
          "flexible",
          "dates"
        ]
      },
      "startDate": {
        "type": "string",
        "maxLength": 10
      },
      "season": {
        "type": "string",
        "enum": [
          "Any season",
          "Spring",
          "Summer",
          "Autumn",
          "Winter"
        ]
      },
      "region": {
        "type": "string",
        "enum": [
          "Anywhere",
          "Europe",
          "Asia",
          "Africa",
          "South America"
        ]
      },
      "interests": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "Coast",
            "Culture",
            "Food",
            "Nature",
            "Adventure",
            "Cities"
          ]
        },
        "minItems": 0,
        "maxItems": 6
      },
      "pace": {
        "type": "string",
        "enum": [
          "Relaxed",
          "Balanced",
          "Active"
        ]
      },
      "transport": {
        "type": "string",
        "enum": [
          "Any transport",
          "Flight",
          "Train"
        ]
      },
      "maxJourneyHours": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 1,
            "maximum": 24
          },
          {
            "type": "null"
          }
        ]
      },
      "crowds": {
        "type": "string",
        "enum": [
          "No preference",
          "Quieter places"
        ]
      },
      "constraints": {
        "type": "string",
        "maxLength": 1500
      },
      "passportCountries": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "minItems": 0,
        "maxItems": 10
      },
      "residenceCountry": {
        "type": "string",
        "pattern": "^(|[A-Z]{2})$",
        "maxLength": 2
      },
      "passportType": {
        "type": "string",
        "enum": [
          "ordinary",
          "other"
        ]
      }
    },
    "required": [
      "departure",
      "currency",
      "dailyBudget",
      "travellers",
      "days",
      "timing",
      "startDate",
      "season",
      "region",
      "interests",
      "pace",
      "transport",
      "maxJourneyHours",
      "crowds",
      "constraints",
      "passportCountries",
      "residenceCountry",
      "passportType"
    ],
    "additionalProperties": false
  },
  "destination": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]{1,70}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "country": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "matchReasons": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "minItems": 2,
        "maxItems": 4
      },
      "tradeoffs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "minItems": 1,
        "maxItems": 3
      },
      "highlights": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "minItems": 2,
        "maxItems": 4
      },
      "dailyCost": {
        "type": "object",
        "properties": {
          "low": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "high": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "low",
          "high"
        ],
        "additionalProperties": false
      },
      "costNote": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "journeyHours": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          {
            "type": "null"
          }
        ]
      },
      "journeyNote": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "seasonNote": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "crowdNote": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "visaAdvice": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "passportCountry": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "status": {
              "type": "string",
              "enum": [
                "visa_may_be_required",
                "visa_exemption_may_apply",
                "check_required"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "passportCountry",
            "status",
            "note"
          ],
          "additionalProperties": false
        },
        "minItems": 0,
        "maxItems": 10
      }
    },
    "required": [
      "id",
      "name",
      "country",
      "matchReasons",
      "tradeoffs",
      "highlights",
      "dailyCost",
      "costNote",
      "journeyHours",
      "journeyNote",
      "seasonNote",
      "crowdNote",
      "visaAdvice"
    ],
    "additionalProperties": false
  },
